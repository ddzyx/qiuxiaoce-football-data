          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "球队历史统计。"
          }
        }
      }
    },
    "/review": {
      "get": {
        "summary": "获取近 N 天官网研报历史表现聚合",
