              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "整体历史统计。仅代表官网历史研报样本，不代表用户调用 API 后的结果。"
          }
        }
      }
    },
    "/stats/team": {
      "get": {
        "summary": "按球队名称查询官网历史研报统计",
